# Settings of the test stack that load tests run against. Not for a real
# server: plain HTTP, a mock sign-in provider, and no rate limits, because
# every simulated person comes from the one address of the load generator.
ATIMA_SITE_ADDRESS=:80
ATIMA_PUBLIC_URL=http://localhost
ATIMA_OIDC_CLIENT_ID=mock-client
ATIMA_OIDC_CLIENT_SECRET=mock-secret-for-testing-only
ATIMA_HTTP_PORT=8088
ATIMA_HTTPS_PORT=8443
ATIMA_LIMIT_SESSION_INIT=100000000
ATIMA_LIMIT_SIGNIN=100000000
ATIMA_LIMIT_LEGACY=100000000
ATIMA_LIMIT_DOWNLOADS=100000000
ATIMA_LIMIT_OAUTH=100000000
ATIMA_LIMIT_API=100000000
