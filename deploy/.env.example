# Settings of an atima server run with deploy/compose.yaml.
#
# Copy this file to deploy/.env and edit the copy. `.env` is not in git and
# must stay out of it: it holds the sign-in provider's client secret.
# As it stands, this file starts a trial server on http://localhost that
# guests can use; signing in needs the provider registration below.


# --- Where the server is ----------------------------------------------------

# What Caddy serves.
#   atima.example.org   HTTPS with a Let's Encrypt certificate (ports 80 and
#                       443 must be reachable from the internet)
#   http://localhost    plain HTTP on this machine only, for a trial run
#   :80                 plain HTTP, for when another proxy in front of this
#                       machine does the TLS
ATIMA_SITE_ADDRESS=http://localhost

# The address people type. Sign-in redirects come back to it, so it must be
# exactly right: https:// (only a localhost address may be http://), the
# host name, no path.
ATIMA_PUBLIC_URL=http://localhost

# Only with another proxy in front: its address or network (CIDR), so that
# its X-Forwarded-* headers are believed.
#ATIMA_TRUSTED_PROXIES=10.0.0.5/32

# Once the site works over HTTPS, tell browsers to insist on it.
#ATIMA_HSTS=max-age=31536000


# --- Signing in -------------------------------------------------------------

# Register the server with the provider as a web application whose redirect
# URL is <ATIMA_PUBLIC_URL>/auth/callback. The default provider is Globus
# Auth; for ORCID set ATIMA_OIDC_ISSUER=https://orcid.org
#ATIMA_OIDC_ISSUER=https://auth.globus.org
ATIMA_OIDC_CLIENT_ID=not-registered-yet
ATIMA_OIDC_CLIENT_SECRET=not-registered-yet

# Administrators, by the provider's identifier for them (`sub`), separated
# by commas. Sign in once, then look it up; the vignette says how.
#ATIMA_ADMINS=

# Shown on the "Privacy and terms" page: who runs this server, and an email
# address or web page for questions.
#ATIMA_OPERATOR=the Example Lab at Example University
#ATIMA_CONTACT=atima@example.org


# --- Size -------------------------------------------------------------------

# Worker processes (each runs one job at a time and needs about 1 GB of
# memory) and CPU cores per job. Left unset, atima uses half the cores, at
# most 4 workers, and divides the cores among them.
#ATIMA_WORKERS=4
#ATIMA_MAX_CPUS=2
#ATIMA_TIME_LIMIT=60
#ATIMA_JOBS_PER_USER=16
#ATIMA_MAX_UPLOAD_MB=50
#ATIMA_CACHE_SIZE_MB=100


# --- Backups ----------------------------------------------------------------

# Where backups go: a directory on another disk or a network share, writable
# by user id 10001. Left unset they go to a Docker volume on this machine,
# which does not survive losing the machine.
#ATIMA_BACKUP_DIR=/mnt/backup/atima

# Hour of the day (UTC) for the nightly backup, and how many are kept.
#ATIMA_BACKUP_HOUR=8
#ATIMA_BACKUP_DAILY=7
#ATIMA_BACKUP_WEEKLY=4


# --- Importing from an older atima (with compose.legacy.yaml) ----------------

#ATIMA_LEGACY_FILE=/srv/atima/atima2.sqlite
#ATIMA_LEGACY_LABEL=atima.example.org before 2027


# --- Rate limits, per visitor address and minute -----------------------------

#ATIMA_LIMIT_SESSION_INIT=120
#ATIMA_LIMIT_SIGNIN=30
#ATIMA_LIMIT_LEGACY=10
#ATIMA_LIMIT_DOWNLOADS=60
#ATIMA_LIMIT_API=1200
