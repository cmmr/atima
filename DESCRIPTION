Package: atima
Type: Package
Title: Visually Analyze Microbiome Data Sets
Version: 5.0.1
Authors@R: c(
    person(
      "Daniel P.", "Smith",
      email   = "dansmith01@gmail.com",
      role    = c("aut", "cre"),
